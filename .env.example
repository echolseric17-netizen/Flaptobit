# Network Configuration
VITE_NETWORK=sepolia
VITE_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
VITE_CHAIN_ID=11155111

# Contract Addresses (fill after deployment)
VITE_FLAP_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
VITE_STAKING_POOL_ADDRESS=0x0000000000000000000000000000000000000000
VITE_PLATFORM_ADDRESS=0x0000000000000000000000000000000000000000

# Wallet Configuration (NEVER commit with real keys!)
PRIVATE_KEY=your_private_key_here
DEPLOYER_ADDRESS=your_deployer_address_here

# Server Configuration
PORT=3000
NODE_ENV=development

# Affiliate API Keys
BINANCE_API_KEY=your_binance_key
CRYPTO_COM_API_KEY=your_crypto_com_key
COINBASE_API_KEY=your_coinbase_key

# Database (if using one later)
DATABASE_URL=mongodb://localhost:27017/flaptobit

# Agent Configuration
AGENT_LOG_LEVEL=info
MAX_CONCURRENT_AGENTS=6
